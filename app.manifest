<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifest de MOSTRADOR (hallazgo AppSec #6).

  asInvoker  — el programa NO pide elevación. Es lo correcto: guarda sus
               datos junto al .exe (o en Documentos), así que no necesita
               ser administrador. También evita que el UAC lo muestre como
               "programa que pide permisos de administrador" (da confianza
               y evita que lo tilden de sospechoso).

  dpiAware PerMonitorV2 + dpiAwareness — la ventana se dibuja nítida en
               monitores Full HD/4K y en mezcla de escalados. Sin esto,
               Windows escala el dibujo y todo se ve borroso/grande.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      version="1.0.0.0"
      processorArchitecture="*"
      name="DOBLEG.MOSTRADOR"
      type="win32" />
  <description>DOBLE G SRL — MOSTRADOR</description>

  <!-- No pedir administrador: el programa no lo necesita -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Pantalla nítida en monitores de alta resolución -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 y 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>
</assembly>
